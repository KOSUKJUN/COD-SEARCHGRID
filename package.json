{
  "name": "cod-searchgrid",
  "version": "0.1.0",
  "description": "SIEM / Splunk style log search grid component for Vue 3",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "files": [
    "dist"
  ],
  "main": "./dist/cod-searchgrid.umd.cjs",
  "module": "./dist/cod-searchgrid.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/cod-searchgrid.js",
      "require": "./dist/cod-searchgrid.umd.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "mock": "node mock-server/server.mjs",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "vue": "^3.5.45",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^31.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
