# Trello 연동 (scripts/trello) — 이 파일을 .env.local 로 복사해서 값을 채우세요.
# .env.local 은 .gitignore 에 포함되어 GitHub 에 올라가지 않습니다.
#
# 1) API Key  : https://trello.com/power-ups/admin → Power-Up 생성 → API 키 생성
# 2) Token    : 같은 화면에서 "Token" 링크로 발급 (읽기+쓰기 권한)
# 3) Board    : 보드 URL (https://trello.com/b/xxxxxxxx/보드이름) — trello.config.json 의 board 로 지정해도 됨
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BOARD=
